# String de conexão com o Postgres. Em dev, o docker-compose.dev.yml sobe um Postgres 16 com essas credenciais.
DATABASE_URL=postgres://admin:admin@localhost:5432/vozzera?sslmode=disable

# Segredo usado pra assinar/validar o JWT do cookie de sessão. Troque por uma string aleatória longa em produção.
JWT_SECRET=

# Código fixo exigido no cadastro (/api/register). Por enquanto é autorização por convite simples — um código único.
INVITE_CODE=

# Porta onde o servidor HTTP escuta. Default 8080 se vazio.
PORT=8080

# Credenciais do projeto no LiveKit Cloud (cloud.livekit.io). Em dev sem voz, pode deixar vazio que o servidor sobe.
# URL do projeto, formato wss://<algo>.livekit.cloud
LIVEKIT_URL=
# API key gerada em Settings → Keys
LIVEKIT_API_KEY=
# API secret (gerado uma vez só junto da key)
LIVEKIT_API_SECRET=
