# String de conexão com o Postgres. Em dev, o docker-compose.dev.yml sobe um Postgres 16 com essas credenciais.
DATABASE_URL=postgres://admin:admin@localhost:5432/vozzera?sslmode=disable

# Código fixo exigido no cadastro (/api/register). Por enquanto é autorização por convite simples — um código único.
INVITE_CODE=

# Duração da sessão (expiração deslizante). Default 168h (7 dias) se vazio.
# Sessão ativa se renova; ocioso cai após esse período sem atividade.
SESSION_TTL=168h

# Janela de renovação da sessão. Quando faltar menos que isso pra expirar, o request estende a sessão.
# Default 24h se vazio. No máximo 1 escrita por sessão dentro dessa janela.
SESSION_TOUCH_WINDOW=24h

# Código fixo exigido no cadastro (/api/register). Por enquanto é autorização por convite simples — um código único.
INVITE_CODE=

# Porta onde o servidor HTTP escuta. Default 8080 se vazio.
PORT=8080

# Credenciais do projeto no LiveKit Cloud (cloud.livekit.io). Em dev sem voz, pode deixar vazio que o servidor sobe.
# URL do projeto, formato wss://<algo>.livekit.cloud
LIVEKIT_URL=
# API key gerada em Settings → Keys
LIVEKIT_API_KEY=
# API secret (gerado uma vez só junto da key)
LIVEKIT_API_SECRET=

# Origins permitidas no CORS (separadas por vírgula). Requisições de origem fora da lista recebem 403.
# Ex.: CORS_ORIGINS=http://localhost:3000,https://app.vozzera.com
CORS_ORIGINS=http://localhost:3000
